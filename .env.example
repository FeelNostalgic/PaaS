# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored — never commit it.

# --- Flask session signing ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_long_random_string

# --- Google OAuth 2.0 / OpenID Connect ---
# From https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be: http://localhost:8080/auth/callback
CLIENT_ID=your-client-id.apps.googleusercontent.com
CLIENT_SECRET=your-client-secret

# --- MongoDB ---
# MongoDB Atlas connection string. Keep the `+srv` scheme so DNS SRV
# resolution is available (see `dnspython` in requirements.txt).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
